# All variables are optional. With none set, the app runs fully in the browser
# (data saved in localStorage) and conflict explanations use a rule-based template.

# Supabase persistence (run supabase/schema.sql first)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# AI conflict explanations (server-side only, used by api/explain.js on Vercel)
ANTHROPIC_API_KEY=
